# Copy to .env.local for local development. Never commit the real .env.local file.

# MongoDB Atlas connection string used by api/contact.js (Vercel serverless
# function) to store contact-form submissions. Server-side only - not
# exposed to the browser bundle since it has no VITE_ prefix.
MONGODB_URI=

# packstack-backend's public base URL, used by src/api/plans.js to fetch
# real pricing for the Pricing section. In production this must point at
# the deployed backend (e.g. https://api.packstack.co.za) and that backend's
# CORS_EXTRA_ORIGINS must include this site's deployed origin - see
# packstack-backend/.env.example.
VITE_API_BASE_URL=http://localhost:4000

# Optional Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Loaded only
# after a visitor accepts cookies (src/lib/analytics.js, wired from
# CookieBanner) - leave unset to run with no analytics at all.
VITE_GA_MEASUREMENT_ID=
